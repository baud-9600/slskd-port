[
{ type: install
  message: <<EOM
To enable and start slskd service:
  sysrc slskd_enable="YES"
  service slskd start

Default config file:
  %%PREFIX%%/etc/slskd.yml

Edit this file to set up:
  - Soulseek and webui auth (webui default is "slskd").
  - Paths to shares and downloads.
  - Other features.

Documentation:
  https://github.com/slskd/slskd/blob/master/docs/config.md

Logs are found here by default:
  /var/db/slskd/slskd.log
  /var/db/slskd/logs

Note: Not changing the download directory before starting the
service will result in downloads being writen to /var/db/slskd
EOM
},
{ type: remove
  message: <<EOM
Note: Any application data in /var/db/slskd remains
untouched and requires manual removal.
EOM
}
]