#!/bin/sh

# PROVIDE: slskd
# REQUIRE: DAEMON NETWORKING
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable this service:
#
# slskd_enable:      Set to YES to enable slskd.
# slskd_user:        The user account slskd runs as.
# slskd_group:       The group associated with the slskd user.
# slskd_data_dir:    Directory where slskd data is stored.
# slskd_config:      Path to slskd config file.
# slskd_flags:       Additional flags that to pass to slskd.
#

. /etc/rc.subr

name="slskd"
rcvar="slskd_enable"

load_rc_config ${name}

: ${slskd_enable:="NO"}
: ${slskd_user:="slskd"}
: ${slskd_group:="slskd"}
: ${slskd_data_dir:="/var/db/slskd"}
: ${slskd_config:="%%PREFIX%%/etc/slskd.yml"}
: ${slskd_flags:=""}

procname="%%PREFIX%%/share/slskd/slskd"
command="/usr/sbin/daemon"
pidfile="/var/run/${name}/${name}.pid"
child_pidfile="/var/run/${name}/${name}-child.pid"
slskd_chdir="%%PREFIX%%/share/slskd"

command_args="-f -p ${pidfile} -P ${child_pidfile} -H ${procname} --app-dir=${slskd_data_dir} --config=${slskd_config} ${slskd_flags}"

start_precmd="slskd_precmd"

slskd_precmd()
{
    if [ ! -d "/var/run/${name}" ]; then
        install -d -m 0750 -o "${slskd_user}" -g "${slskd_group}" "/var/run/${name}"
    fi
    if [ ! -d "${slskd_data_dir}" ]; then
        install -d -m 0750 -o "${slskd_user}" -g "${slskd_group}" "${slskd_data_dir}"
    fi
}

run_rc_command "$1"